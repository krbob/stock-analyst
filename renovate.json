{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>krbob/renovate-config:monthly"
  ],
  "rangeStrategy": "pin",
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci-build\\.yml$/"
      ],
      "matchStrings": [
        "hadolint/hadolint:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[a-f0-9]+)"
      ],
      "depNameTemplate": "hadolint/hadolint",
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Group routine Python backend updates",
      "matchManagers": [
        "pip_requirements"
      ],
      "matchPackageNames": [
        "Flask",
        "flask",
        "waitress",
        "pytest"
      ],
      "matchUpdateTypes": [
        "patch",
        "minor",
        "digest",
        "pin"
      ],
      "groupName": "Python backend dependencies"
    }
  ]
}
